  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>cps_coordination</exec_depend>
  <exec_depend>cps_msgs</exec_depend>
  <exec_depend>cps_telemetry</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

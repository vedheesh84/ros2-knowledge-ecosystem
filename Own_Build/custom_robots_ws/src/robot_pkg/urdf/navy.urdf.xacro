<?xml version="1.0"?>
<robot name="navy" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== Materials ===================== -->
  <xacro:macro name="material_color" params="name r g b a">
    <material name="${name}">
      <color rgba="${r} ${g} ${b} ${a}"/>
    </material>
  </xacro:macro>

  <xacro:material_color name="body_orange" r="1.0" g="0.45" b="0.05" a="1.0"/>
  <xacro:material_color name="matte_black" r="0.08" g="0.08" b="0.08" a="1.0"/>
  <xacro:material_color name="wheel_black" r="0.02" g="0.02" b="0.02" a="1.0"/>
  <xacro:material_color name="suspension_red" r="0.85" g="0.1" b="0.1" a="1.0"/>
  <xacro:material_color name="led_green" r="0.0" g="1.0" b="0.2" a="1.0"/>
  <xacro:material_color name="lidar_grey" r="0.35" g="0.35" b="0.35" a="1.0"/>
  <xacro:material_color name="camera_dark" r="0.15" g="0.15" b="0.15" a="1.0"/>

  <!-- ===================== Parameters ===================== -->
  <xacro:property name="wheel_radius" value="0.15"/>
  <xacro:property name="base_length" value="0.90"/>
  <xacro:property name="base_width" value="0.65"/>
  <xacro:property name="base_height" value="0.28"/>
  <xacro:property name="base_z" value="${wheel_radius}"/>
  <xacro:property name="wheel_width" value="0.12"/>
  <xacro:property name="wheel_separation" value="0.55"/>
  <xacro:property name="wheel_x_rear" value="-0.30"/>
  <xacro:property name="wheel_x_front" value="0.30"/>
  <xacro:property name="wheel_y" value="${wheel_separation / 2.0}"/>

  <!-- ===================== Base Link ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_z + base_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="body_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_z + base_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_z + base_height / 2.0}" rpy="0 0 0"/>
      <mass value="85.0"/>
      <inertia ixx="8.0" ixy="0.0" ixz="0.0"
               iyy="12.0" iyz="0.0"
               izz="15.0"/>
    </inertial>
  </link>

  <!-- Front LED strips (visual only) -->
  <link name="front_led_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.02 0.01"/>
      </geometry>
      <material name="led_green"/>
    </visual>
  </link>
  <joint name="front_led_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_led_left_link"/>
    <origin xyz="${base_length / 2.0 - 0.02} 0.18 ${base_z + 0.08}" rpy="0 0 0"/>
  </joint>

  <link name="front_led_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.02 0.01"/>
      </geometry>
      <material name="led_green"/>
    </visual>
  </link>
  <joint name="front_led_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_led_right_link"/>
    <origin xyz="${base_length / 2.0 - 0.02} -0.18 ${base_z + 0.08}" rpy="0 0 0"/>
  </joint>

  <!-- Front camera -->
  <link name="front_camera_link">
    <visual>
      <geometry>
        <box size="0.06 0.10 0.04"/>
      </geometry>
      <material name="camera_dark"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.10 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_camera_link"/>
    <origin xyz="${base_length / 2.0 - 0.01} 0 ${base_z + 0.12}" rpy="0 0 0"/>
  </joint>

  <!-- ===================== Wheel Macro ===================== -->
  <xacro:macro name="wheel" params="name x y joint_type joint_name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="4.0"/>
        <inertia ixx="0.08" ixy="0" ixz="0"
                 iyy="0.08" iyz="0"
                 izz="0.04"/>
      </inertial>
    </link>

    <joint name="${joint_name}" type="${joint_type}">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <!-- Suspension strut (visual) -->
    <link name="${name}_suspension_link">
      <visual>
        <origin xyz="0 0 0.06" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.015" length="0.12"/>
        </geometry>
        <material name="suspension_red"/>
      </visual>
    </link>
    <joint name="${name}_suspension_joint" type="fixed">
      <parent link="${name}"/>
      <child link="${name}_suspension_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${name}">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <!-- Rear driven wheels -->
  <xacro:wheel name="rear_left_wheel" x="${wheel_x_rear}" y="${wheel_y}"
               joint_type="continuous" joint_name="rear_left_wheel_joint"/>
  <xacro:wheel name="rear_right_wheel" x="${wheel_x_rear}" y="${-wheel_y}"
               joint_type="continuous" joint_name="rear_right_wheel_joint"/>

  <!-- Front caster wheels (fixed for stability) -->
  <xacro:wheel name="front_left_wheel" x="${wheel_x_front}" y="${wheel_y}"
               joint_type="fixed" joint_name="front_left_wheel_joint"/>
  <xacro:wheel name="front_right_wheel" x="${wheel_x_front}" y="${-wheel_y}"
               joint_type="fixed" joint_name="front_right_wheel_joint"/>

  <gazebo reference="front_left_wheel">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>0.01</mu1>
    <mu2>0.01</mu2>
  </gazebo>

  <!-- ===================== LiDAR ===================== -->
  <link name="lidar_link">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.10"/>
      </geometry>
      <material name="lidar_grey"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.08" length="0.10"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.10 0 ${base_z + base_height + 0.05}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="lidar_link">
    <material>Gazebo/Grey</material>
    <sensor name="lidar" type="ray">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===================== Robotic Arm (visual approximation) ===================== -->
  <link name="arm_base_link">
    <visual>
      <geometry>
        <cylinder radius="0.08" length="0.06"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.08" length="0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="arm_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_base_link"/>
    <origin xyz="-0.20 0 ${base_z + base_height}" rpy="0 0 3.14159"/>
  </joint>

  <link name="arm_link1">
    <visual>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.36"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.10 0.36"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.08" ixy="0" ixz="0" iyy="0.08" iyz="0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="arm_joint1" type="fixed">
    <parent link="arm_base_link"/>
    <child link="arm_link1"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
  </joint>

  <link name="arm_link2">
    <visual>
      <origin xyz="0 0 0.22" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.44"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.22" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.44"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.22" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia ixx="0.07" ixy="0" ixz="0" iyy="0.07" iyz="0" izz="0.02"/>
    </inertial>
  </link>
  <joint name="arm_joint2" type="revolute">
    <parent link="arm_link1"/>
    <child link="arm_link2"/>
    <origin xyz="0 0 0.36" rpy="0 0.4 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="20.0" velocity="1.0"/>
  </joint>

  <link name="arm_link3">
    <visual>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.07 0.36"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <geometry>
        <box size="0.07 0.07 0.36"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.18" rpy="0 0 0"/>
      <mass value="2.5"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.04" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="arm_joint3" type="revolute">
    <parent link="arm_link2"/>
    <child link="arm_link3"/>
    <origin xyz="0 0 0.44" rpy="0 3.14159 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="20.0" velocity="1.0"/>
  </joint>

  <link name="wrist_camera_link">
    <visual>
      <geometry>
        <box size="0.05 0.08 0.03"/>
      </geometry>
      <material name="camera_dark"/>
    </visual>
  </link>
  <joint name="wrist_camera_joint" type="fixed">
    <parent link="arm_link3"/>
    <child link="wrist_camera_link"/>
    <origin xyz="0 0 0.30" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="curved_gripper_finger" params="prefix y_sign">
  <link name="${prefix}_finger_link1">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.05"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
  </link>
  <joint name="${prefix}_finger_joint1" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="${prefix}_finger_link1"/>
    <origin xyz="0 ${y_sign * 0.025} 0" rpy="0 0 ${y_sign * 0.15}"/>
  </joint>

  <link name="${prefix}_finger_link2">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.04"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
  </link>
  <joint name="${prefix}_finger_joint2" type="revolute">
    <parent link="${prefix}_finger_link1"/>
    <child link="${prefix}_finger_link2"/>
    <origin xyz="0 0 0.05" rpy="0 -0.75 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="5.0" velocity="1.5"/>
  </joint>

  <link name="${prefix}_finger_link3">
    <visual>
      <origin xyz="0 0 0.018" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.036"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
  </link>
  <joint name="${prefix}_finger_joint3" type="revolute">
    <parent link="${prefix}_finger_link2"/>
    <child link="${prefix}_finger_link3"/>
    <origin xyz="0 0 0.04" rpy="0 -0.75 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.2" upper="1.2" effort="5.0" velocity="1.5"/>
  </joint>
  </xacro:macro>

  <link name="gripper_base_link">
    <visual>
      <geometry>
        <box size="0.06 0.04 0.04"/>
      </geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.06 0.04 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>
  <joint name="gripper_base_joint" type="revolute">
    <parent link="arm_link3"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 0.38" rpy="0 -1.2 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="8.0" velocity="1.0"/>
  </joint>

  <xacro:curved_gripper_finger prefix="gripper_left" y_sign="1"/>
  <xacro:curved_gripper_finger prefix="gripper_right" y_sign="-1"/>

  <!-- ===================== Gazebo Materials ===================== -->
  <gazebo reference="base_link">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo reference="arm_base_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="arm_link1">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="arm_link2">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="arm_link3">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="gripper_base_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="gripper_left_finger_link1">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="gripper_left_finger_link2">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="gripper_left_finger_link3">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="gripper_right_finger_link1">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="gripper_right_finger_link2">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="gripper_right_finger_link3">
    <material>Gazebo/Black</material>
  </gazebo>

  <!-- ===================== Gazebo Diff Drive ===================== -->
  <gazebo>
    <plugin name="navy_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=/cmd_vel</remapping>
      </ros>

      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>

      <max_wheel_torque>300</max_wheel_torque>
      <max_wheel_acceleration>8.0</max_wheel_acceleration>

      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
  </gazebo>

</robot>

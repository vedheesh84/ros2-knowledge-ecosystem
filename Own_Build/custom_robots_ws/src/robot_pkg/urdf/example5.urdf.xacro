<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="triangle_bot">

  <xacro:property name="base_length" value="0.25"/>
  <xacro:property name="base_width" value="0.25"/>
  <xacro:property name="base_height" value="0.05"/>
  <xacro:property name="base_z" value="0.05"/>
  <xacro:property name="base_mass" value="3.0"/>
  <xacro:property name="base_inertia" value="0.02"/>

  <xacro:property name="body_length" value="0.22"/>
  <xacro:property name="body_width" value="0.03"/>

  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_length" value="0.03"/>
  <xacro:property name="wheel_mass" value="0.5"/>
  <xacro:property name="wheel_inertia" value="0.001"/>

  <xacro:property name="caster_radius" value="0.03"/>
  <xacro:property name="caster_mass" value="0.2"/>
  <xacro:property name="caster_inertia" value="0.0001"/>

  <material name="blue">
    <color rgba="0.0 0.2 1.0 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_z}"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_z}"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_z}"/>
      <mass value="${base_mass}"/>
      <inertia
        ixx="${base_inertia}"
        ixy="0"
        ixz="0"
        iyy="${base_inertia}"
        iyz="0"
        izz="${base_inertia}"/>
    </inertial>
  </link>

  <link name="left_body">
    <visual>
      <origin xyz="0.10 0.08 ${base_z}"
              rpy="0 0 0.7"/>
      <geometry>
        <box size="${body_length} ${body_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="left_body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="left_body"/>
    <origin xyz="0 0 0"/>
  </joint>

  <link name="right_body">
    <visual>
      <origin xyz="0.10 -0.08 ${base_z}"
              rpy="0 0 -0.7"/>
      <geometry>
        <box size="${body_length} ${body_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="right_body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_body"/>
    <origin xyz="0 0 0"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}"
                  length="${wheel_length}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}"
                  length="${wheel_length}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${wheel_inertia}"
        ixy="0"
        ixz="0"
        iyy="${wheel_inertia}"
        iyz="0"
        izz="${wheel_inertia}"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.08 0.14 ${base_z}"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}"
                  length="${wheel_length}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="${wheel_radius}"
                  length="${wheel_length}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${wheel_mass}"/>
      <inertia
        ixx="${wheel_inertia}"
        ixy="0"
        ixz="0"
        iyy="${wheel_inertia}"
        iyz="0"
        izz="${wheel_inertia}"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.08 -0.14 ${base_z}"/>
    <axis xyz="0 1 0"/>
  </joint>

  <link name="caster_wheel">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <inertia
        ixx="${caster_inertia}"
        ixy="0"
        ixz="0"
        iyy="${caster_inertia}"
        iyz="0"
        izz="${caster_inertia}"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="0.15 0 ${caster_radius}"/>
  </joint>

</robot>

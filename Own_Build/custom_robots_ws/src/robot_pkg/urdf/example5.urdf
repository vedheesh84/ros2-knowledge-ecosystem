<?xml version="1.0"?>
<robot name="triangle_bot">

  <!-- ==========================
       MATERIALS
  =========================== -->
  <material name="blue">
    <color rgba="0.0 0.2 1.0 1.0"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <!-- ==========================
       BASE LINK
  =========================== -->
  <link name="base_link">

    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <box size="0.25 0.25 0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <box size="0.25 0.25 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="3.0"/>
      <inertia
        ixx="0.02"
        ixy="0"
        ixz="0"
        iyy="0.02"
        iyz="0"
        izz="0.02"/>
    </inertial>

  </link>

  <!-- ==========================
       LEFT TRIANGLE SIDE
  =========================== -->
  <link name="left_body">

    <visual>
      <origin xyz="0.10 0.08 0.05"
              rpy="0 0 0.7"/>
      <geometry>
        <box size="0.22 0.03 0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>

  </link>

  <joint name="left_body_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="left_body"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- ==========================
       RIGHT TRIANGLE SIDE
  =========================== -->
  <link name="right_body">

    <visual>
      <origin xyz="0.10 -0.08 0.05"
              rpy="0 0 -0.7"/>
      <geometry>
        <box size="0.22 0.03 0.05"/>
      </geometry>
      <material name="blue"/>
    </visual>

  </link>

  <joint name="right_body_joint"
         type="fixed">
    <parent link="base_link"/>
    <child link="right_body"/>
    <origin xyz="0 0 0"/>
  </joint>

  <!-- ==========================
       LEFT WHEEL
  =========================== -->
  <link name="left_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05"
                  length="0.03"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05"
                  length="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

  </link>

  <joint name="left_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="left_wheel"/>

    <origin xyz="-0.08 0.14 0.05"/>

    <axis xyz="0 1 0"/>

  </joint>

  <!-- ==========================
       RIGHT WHEEL
  =========================== -->
  <link name="right_wheel">

    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05"
                  length="0.03"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.05"
                  length="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

  </link>

  <joint name="right_wheel_joint"
         type="continuous">

    <parent link="base_link"/>
    <child link="right_wheel"/>

    <origin xyz="-0.08 -0.14 0.05"/>

    <axis xyz="0 1 0"/>

  </joint>

  <!-- ==========================
       FRONT CASTER
  =========================== -->
  <link name="caster_wheel">

    <visual>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="gray"/>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.2"/>
      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>
    </inertial>

  </link>

  <joint name="caster_joint"
         type="fixed">

    <parent link="base_link"/>
    <child link="caster_wheel"/>

    <origin xyz="0.15 0 0.03"/>

  </joint>

</robot>
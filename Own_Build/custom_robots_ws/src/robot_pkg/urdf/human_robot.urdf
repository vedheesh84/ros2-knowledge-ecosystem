<?xml version="1.0"?>
<robot name="human_robot">

  <material name="skin">
    <color rgba="0.92 0.78 0.66 1.0"/>
  </material>
  <material name="hair_dark">
    <color rgba="0.10 0.08 0.06 1.0"/>
  </material>
  <material name="shirt_blue">
    <color rgba="0.12 0.30 0.72 1.0"/>
  </material>
  <material name="shirt_white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>
  <material name="pants_black">
    <color rgba="0.18 0.18 0.22 1.0"/>
  </material>
  <material name="shoe_black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>
  <material name="eye_black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>
  <material name="hidden_base">
    <color rgba="0.5 0.5 0.5 0.05"/>
  </material>

  <link name="base_link">
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.30 0.22 0.10"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <mass value="22.0"/>
      <inertia ixx="0.22" ixy="0.0" ixz="0.0" iyy="0.22" iyz="0.0" izz="0.22"/>
    </inertial>
  </link>

  <link name="torso">
    <visual>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.11 0.28"/>
      </geometry>
      <material name="shirt_blue"/>
    </visual>
    <visual>
      <origin xyz="0.085 0 0.16" rpy="0 0 0"/>
      <geometry>
        <box size="0.01 0.10 0.10"/>
      </geometry>
      <material name="shirt_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry>
        <box size="0.18 0.11 0.28"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <mass value="3.0"/>
      <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.02"/>
    </inertial>
  </link>

  <joint name="base_to_torso" type="fixed">
    <parent link="base_link"/>
    <child link="torso"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <link name="head">
    <visual>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <visual>
      <origin xyz="0 0 0.135" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.081"/>
      </geometry>
      <material name="hair_dark"/>
    </visual>
    <visual>
      <origin xyz="0.060 0.028 0.095" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
      <material name="eye_black"/>
    </visual>
    <visual>
      <origin xyz="0.060 -0.028 0.095" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
      <material name="eye_black"/>
    </visual>
    <visual>
      <origin xyz="0.074 0 0.072" rpy="0 0 0"/>
      <geometry>
        <box size="0.016 0.018 0.028"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <visual>
      <origin xyz="0.070 0 0.040" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.040 0.006"/>
      </geometry>
      <material name="eye_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.005"/>
    </inertial>
  </link>

  <joint name="torso_to_head" type="fixed">
    <parent link="torso"/>
    <child link="head"/>
    <origin xyz="0 0 0.29" rpy="0 0 0"/>
  </joint>

  <link name="left_upper_arm">
    <visual>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.15"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="torso_to_left_shoulder" type="revolute">
    <parent link="torso"/>
    <child link="left_upper_arm"/>
    <origin xyz="0 0.085 0.24" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.6" upper="0.6" effort="10.0" velocity="1.0"/>
    <dynamics damping="12.0" friction="4.0"/>
  </joint>

  <link name="left_forearm">
    <visual>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.019" length="0.14"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.019" length="0.14"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0008" ixy="0.0" ixz="0.0" iyy="0.0008" iyz="0.0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="left_elbow" type="revolute">
    <parent link="left_upper_arm"/>
    <child link="left_forearm"/>
    <origin xyz="0 0 -0.15" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.0" effort="8.0" velocity="1.0"/>
    <dynamics damping="10.0" friction="4.0"/>
  </joint>

  <link name="right_upper_arm">
    <visual>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.15"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.022" length="0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.075" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.0005"/>
    </inertial>
  </link>

  <joint name="torso_to_right_shoulder" type="revolute">
    <parent link="torso"/>
    <child link="right_upper_arm"/>
    <origin xyz="0 -0.085 0.24" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.6" upper="0.6" effort="10.0" velocity="1.0"/>
    <dynamics damping="12.0" friction="4.0"/>
  </joint>

  <link name="right_forearm">
    <visual>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.019" length="0.14"/>
      </geometry>
      <material name="skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.019" length="0.14"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.07" rpy="0 0 0"/>
      <mass value="0.25"/>
      <inertia ixx="0.0008" ixy="0.0" ixz="0.0" iyy="0.0008" iyz="0.0" izz="0.0004"/>
    </inertial>
  </link>

  <joint name="right_elbow" type="revolute">
    <parent link="right_upper_arm"/>
    <child link="right_forearm"/>
    <origin xyz="0 0 -0.15" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="1.0" effort="8.0" velocity="1.0"/>
    <dynamics damping="10.0" friction="4.0"/>
  </joint>

  <link name="left_thigh">
    <visual>
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.18"/>
      </geometry>
      <material name="pants_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.18"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.0008"/>
    </inertial>
  </link>

  <joint name="left_hip" type="revolute">
    <parent link="torso"/>
    <child link="left_thigh"/>
    <origin xyz="0 0.045 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.35" upper="0.35" effort="16.0" velocity="1.0"/>
    <dynamics damping="18.0" friction="8.0"/>
  </joint>

  <link name="left_shin">
    <visual>
      <origin xyz="0 0 -0.085" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.17"/>
      </geometry>
      <material name="pants_black"/>
    </visual>
    <visual>
      <origin xyz="0.045 0 -0.185" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.045 0.025"/>
      </geometry>
      <material name="shoe_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.085" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.17"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.045 0 -0.185" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.045 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.085" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.0015" iyz="0.0" izz="0.0006"/>
    </inertial>
  </link>

  <joint name="left_knee" type="revolute">
    <parent link="left_thigh"/>
    <child link="left_shin"/>
    <origin xyz="0 0 -0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.7" effort="14.0" velocity="1.0"/>
    <dynamics damping="16.0" friction="8.0"/>
  </joint>

  <link name="right_thigh">
    <visual>
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.18"/>
      </geometry>
      <material name="pants_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.027" length="0.18"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.09" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0" iyy="0.002" iyz="0.0" izz="0.0008"/>
    </inertial>
  </link>

  <joint name="right_hip" type="revolute">
    <parent link="torso"/>
    <child link="right_thigh"/>
    <origin xyz="0 -0.045 0.02" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.35" upper="0.35" effort="16.0" velocity="1.0"/>
    <dynamics damping="18.0" friction="8.0"/>
  </joint>

  <link name="right_shin">
    <visual>
      <origin xyz="0 0 -0.085" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.17"/>
      </geometry>
      <material name="pants_black"/>
    </visual>
    <visual>
      <origin xyz="0.045 0 -0.185" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.045 0.025"/>
      </geometry>
      <material name="shoe_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.085" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.17"/>
      </geometry>
    </collision>
    <collision>
      <origin xyz="0.045 0 -0.185" rpy="0 0 0"/>
      <geometry>
        <box size="0.09 0.045 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 -0.085" rpy="0 0 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.0015" ixy="0.0" ixz="0.0" iyy="0.0015" iyz="0.0" izz="0.0006"/>
    </inertial>
  </link>

  <joint name="right_knee" type="revolute">
    <parent link="right_thigh"/>
    <child link="right_shin"/>
    <origin xyz="0 0 -0.18" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.7" effort="14.0" velocity="1.0"/>
    <dynamics damping="16.0" friction="8.0"/>
  </joint>

  <ros2_control name="HumanRobotSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="torso_to_left_shoulder">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_elbow">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="torso_to_right_shoulder">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_elbow">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_hip">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="left_knee">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_hip">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="right_knee">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <gazebo reference="base_link">
    <mu1>10.0</mu1>
    <mu2>10.0</mu2>
    <kp>200000.0</kp>
    <kd>4000.0</kd>
  </gazebo>

  <gazebo>
    <plugin name="human_planar_move" filename="libgazebo_ros_planar_move.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>
      <update_rate>100</update_rate>
      <publish_rate>30</publish_rate>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so"/>
  </gazebo>

</robot>

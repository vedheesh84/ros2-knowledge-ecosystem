<?xml version="1.0"?>
<sdf version="1.6">
  <world name="mapping_world">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.8 1</background>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="north_wall">
      <static>true</static>
      <pose>0 4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.15 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.15 1</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="south_wall">
      <static>true</static>
      <pose>0 -4 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>8 0.15 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>8 0.15 1</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="east_wall">
      <static>true</static>
      <pose>4 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 8 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 8 1</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="west_wall">
      <static>true</static>
      <pose>-4 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.15 8 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.15 8 1</size></box></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="center_block">
      <static>true</static>
      <pose>1.2 0.4 0.35 0 0 0.35</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.45 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.45 0.7</size></box></geometry>
          <material><ambient>0.2 0.45 0.8 1</ambient><diffuse>0.2 0.45 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="left_block">
      <static>true</static>
      <pose>-1.5 1.5 0.35 0 0 -0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.55 1.2 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.55 1.2 0.7</size></box></geometry>
          <material><ambient>0.8 0.35 0.2 1</ambient><diffuse>0.8 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="right_block">
      <static>true</static>
      <pose>1.8 -1.7 0.35 0 0 0.2</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.7 0.7 0.7</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.7 0.7 0.7</size></box></geometry>
          <material><ambient>0.25 0.65 0.35 1</ambient><diffuse>0.25 0.65 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>

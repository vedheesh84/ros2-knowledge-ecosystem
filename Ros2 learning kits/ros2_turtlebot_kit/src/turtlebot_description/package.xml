<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtlebot_description</name>
  <version>1.0.0</version>
  <description>
    TurtleBot AMR robot description (URDF/xacro) for the ROS2 Learning Kit.

    Includes:
    - Differential drive base (2 wheels + casters)
    - LiDAR sensor mount
    - IMU sensor
    - Optional camera mount
    - ros2_control hardware interface tags
    - Gazebo simulation plugins

    This package builds on concepts from learning_tf in ROS2_kits_ws.
  </description>
  <maintainer email="learner@ros2kit.local">ROS2 Kit Learner</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>urdf</depend>
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_publisher</depend>
  <depend>joint_state_publisher_gui</depend>
  <depend>rviz2</depend>

  <!-- Gazebo dependencies -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>

  <!-- ros2_control dependencies -->
  <depend>controller_manager</depend>
  <depend>diff_drive_controller</depend>
  <depend>joint_state_broadcaster</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<?xml version="1.0"?>
<!--
  companion_room.world - Indoor environment for Companion Head testing

  LEARNING OBJECTIVES:
  ====================
  1. Understand Gazebo world files
  2. See how to create test environments
  3. Learn about lighting and physics setup

  FEATURES:
  =========
  - Indoor room with walls
  - Good lighting for camera testing
  - Face poster targets for detection testing
  - Table for robot placement
-->
<sdf version="1.6">
  <world name="companion_room">

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Scene -->
    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.7 0.8 0.9 1.0</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Room light -->
    <light type="point" name="room_light">
      <pose>0 0 2.5 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>10</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Table for robot -->
    <model name="table">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="table_top">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 0.6 0.02</size>
            </box>
          </geometry>
          <pose>0 0 0.75 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 0.6 0.02</size>
            </box>
          </geometry>
          <pose>0 0 0.75 0 0 0</pose>
          <material>
            <ambient>0.6 0.4 0.2 1</ambient>
            <diffuse>0.6 0.4 0.2 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="leg1">
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.74</length></cylinder></geometry>
          <pose>0.35 0.25 0.37 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.74</length></cylinder></geometry>
          <pose>0.35 0.25 0.37 0 0 0</pose>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
      <link name="leg2">
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.74</length></cylinder></geometry>
          <pose>-0.35 0.25 0.37 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.74</length></cylinder></geometry>
          <pose>-0.35 0.25 0.37 0 0 0</pose>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
      <link name="leg3">
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.74</length></cylinder></geometry>
          <pose>0.35 -0.25 0.37 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.74</length></cylinder></geometry>
          <pose>0.35 -0.25 0.37 0 0 0</pose>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
      <link name="leg4">
        <collision name="collision">
          <geometry><cylinder><radius>0.03</radius><length>0.74</length></cylinder></geometry>
          <pose>-0.35 -0.25 0.37 0 0 0</pose>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.03</radius><length>0.74</length></cylinder></geometry>
          <pose>-0.35 -0.25 0.37 0 0 0</pose>
          <material><ambient>0.3 0.3 0.3 1</ambient></material>
        </visual>
      </link>
    </model>

    <!-- Back wall -->
    <model name="back_wall">
      <static>true</static>
      <pose>0 2 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>4 0.1 2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>4 0.1 2</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.85 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Face target (simple colored box to represent a person) -->
    <model name="face_target">
      <static>true</static>
      <pose>0 -1.5 1.2 0 0 0</pose>
      <link name="body">
        <visual name="head">
          <geometry>
            <sphere><radius>0.15</radius></sphere>
          </geometry>
          <pose>0 0 0.35 0 0 0</pose>
          <material>
            <ambient>0.9 0.75 0.6 1</ambient>
            <diffuse>0.9 0.75 0.6 1</diffuse>
          </material>
        </visual>
        <visual name="body">
          <geometry>
            <cylinder><radius>0.2</radius><length>0.5</length></cylinder>
          </geometry>
          <pose>0 0 0 0 0 0</pose>
          <material>
            <ambient>0.2 0.4 0.8 1</ambient>
            <diffuse>0.2 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>

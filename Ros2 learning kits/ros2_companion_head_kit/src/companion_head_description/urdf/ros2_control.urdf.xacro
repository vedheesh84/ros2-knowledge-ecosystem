<?xml version="1.0"?>
<!--
  ros2_control.urdf.xacro - Hardware interface configuration

  LEARNING OBJECTIVES:
  ====================
  1. Understand ros2_control hardware abstraction
  2. Learn about command and state interfaces
  3. See how sim vs real hardware is handled

  INTERFACES:
  ===========
  - Position command: Send target joint angles
  - Position state: Read current joint angles
  - Velocity state: Read current joint velocities
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <ros2_control name="companion_head_system" type="system">

    <!-- Simulation hardware (Gazebo) -->
    <xacro:if value="$(arg use_sim)">
      <hardware>
        <plugin>gazebo_ros2_control/GazeboSystem</plugin>
      </hardware>
    </xacro:if>

    <!-- Fake hardware for testing without real robot -->
    <xacro:if value="$(arg use_fake_hardware)">
      <xacro:unless value="$(arg use_sim)">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
          <param name="calculate_dynamics">true</param>
        </hardware>
      </xacro:unless>
    </xacro:if>

    <!-- Real hardware interface (when not sim or fake) -->
    <xacro:unless value="$(arg use_sim)">
      <xacro:unless value="$(arg use_fake_hardware)">
        <hardware>
          <plugin>companion_head_hardware/ServoInterface</plugin>
          <param name="serial_port">$(arg serial_port)</param>
          <param name="baud_rate">$(arg baud_rate)</param>
        </hardware>
      </xacro:unless>
    </xacro:unless>

    <!-- Pan joint -->
    <joint name="neck_pan_joint">
      <command_interface name="position">
        <param name="min">${-pi/2}</param>
        <param name="max">${pi/2}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <!-- Tilt joint -->
    <joint name="neck_tilt_joint">
      <command_interface name="position">
        <param name="min">${-pi/6}</param>
        <param name="max">${pi/4}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

  </ros2_control>

</robot>

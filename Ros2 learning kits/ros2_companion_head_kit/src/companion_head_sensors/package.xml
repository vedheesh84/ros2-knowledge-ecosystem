<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>companion_head_sensors</name>
  <version>0.1.0</version>
  <description>
    Sensor processing for Companion Head robot.

    NODES:
    ======
    - face_detector: OpenCV-based face detection
    - audio_simulator: Simulated speech recognition

    LEARNING OBJECTIVES:
    ====================
    - Image processing pipeline
    - Face detection with OpenCV
    - Simulated sensor patterns
  </description>
  <maintainer email="ved@example.com">Ved</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>companion_head_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

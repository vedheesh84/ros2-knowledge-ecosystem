<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>companion_head_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch file orchestration for Companion Head robot.

    Provides launch files for:
    - Simulation (Gazebo + full stack)
    - Hardware (real robot)
    - Full system integration
  </description>
  <maintainer email="ved@example.com">Ved</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>companion_head_description</exec_depend>
  <exec_depend>companion_head_gazebo</exec_depend>
  <exec_depend>companion_head_control</exec_depend>
  <exec_depend>companion_head_expression</exec_depend>
  <exec_depend>companion_head_sensors</exec_depend>
  <exec_depend>companion_head_behaviors</exec_depend>

  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

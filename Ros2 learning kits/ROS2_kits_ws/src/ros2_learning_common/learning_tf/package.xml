<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>learning_tf</name>
  <version>1.0.0</version>
  <description>
    ROS2 Learning Package: TF2 Coordinate Frames and Transforms

    Learn how robots track coordinate frames and transform between them.
  </description>
  <maintainer email="learner@ros2.org">ROS2 Learner</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf_transformations</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>learning_core</name>
  <version>1.0.0</version>
  <description>
    ROS2 Learning Package: Core Concepts

    This package teaches the fundamental mental model of ROS2:
    - What is a node?
    - What is the computation graph?
    - How do parameters work?
    - How is a workspace structured?

    Start here if you're new to ROS2!
  </description>

  <maintainer email="learner@ros2.org">ROS2 Learner</maintainer>
  <license>MIT</license>

  <!-- Build system -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Runtime dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <!-- Testing -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

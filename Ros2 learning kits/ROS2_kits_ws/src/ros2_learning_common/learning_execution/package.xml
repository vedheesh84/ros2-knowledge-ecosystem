<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>learning_execution</name>
  <version>1.0.0</version>
  <description>
    ROS2 Learning Package: Launch, Composition, and Runtime Control

    This package teaches how to orchestrate multi-node systems:
    - Launch files (Python)
    - Topic remapping
    - Node composition
    - Parameter passing at launch
    - Conditional launching
  </description>

  <maintainer email="learner@ros2.org">ROS2 Learner</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

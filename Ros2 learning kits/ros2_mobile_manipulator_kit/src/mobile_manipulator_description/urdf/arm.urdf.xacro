<?xml version="1.0"?>
<!--
  Arm URDF (5-DOF Manipulator)

  LEARNING OBJECTIVES:
  - Understand serial kinematic chain
  - See joint limits and axis definitions
  - Learn gripper mimic joint pattern

  STRUCTURE (5-DOF lacks Y-axis movement):
  - joint_1: Base rotation (Z-axis)
  - joint_2: Shoulder pitch (Y-axis)
  - joint_3: Elbow pitch (Y-axis)
  - joint_4: Wrist pitch (Y-axis)
  - gripper_base_joint: Wrist rotation (Z-axis)
  - left_gear_joint: Gripper open/close (Z-axis)
  - Mimic joints: right_gear, fingers

  NOTE: This is a simplified URDF for learning.
  For real hardware, reference arm_description package from gripper_car_ws.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== PROPERTIES ===================== -->
  <xacro:property name="link_1_length" value="0.04"/>
  <xacro:property name="link_2_length" value="0.12"/>
  <xacro:property name="link_3_length" value="0.10"/>
  <xacro:property name="link_4_length" value="0.08"/>

  <!-- ===================== INERTIA MACROS ===================== -->
  <xacro:macro name="arm_cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0.0" ixz="0.0"
             iyy="${m*(3*r*r+h*h)/12.0}" iyz="0.0"
             izz="${m*r*r/2.0}"/>
  </xacro:macro>

  <!-- ===================== ARM BASE ===================== -->
  <joint name="arm_base_joint" type="fixed">
    <parent link="arm_mount_link"/>
    <child link="arm_base_link"/>
    <origin xyz="0 0 0.01" rpy="0 0 0"/>
  </joint>

  <link name="arm_base_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <material name="arm_material">
        <color rgba="0.8 0.8 0.9 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <xacro:arm_cylinder_inertia m="0.1" r="0.04" h="0.05"/>
    </inertial>
  </link>

  <!-- ===================== JOINT 1: Base Rotation (Z) ===================== -->
  <joint name="joint_1" type="revolute">
    <parent link="arm_base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="10.0" velocity="2.0"/>
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 ${link_1_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="${link_1_length}"/>
      </geometry>
      <material name="arm_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${link_1_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="${link_1_length}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <origin xyz="0 0 ${link_1_length/2}" rpy="0 0 0"/>
      <xacro:arm_cylinder_inertia m="0.08" r="0.03" h="${link_1_length}"/>
    </inertial>
  </link>

  <!-- ===================== JOINT 2: Shoulder Pitch (Y) ===================== -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 ${link_1_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="10.0" velocity="2.0"/>
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 ${link_2_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="${link_2_length}"/>
      </geometry>
      <material name="arm_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${link_2_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="${link_2_length}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.06"/>
      <origin xyz="0 0 ${link_2_length/2}" rpy="0 0 0"/>
      <xacro:arm_cylinder_inertia m="0.06" r="0.025" h="${link_2_length}"/>
    </inertial>
  </link>

  <!-- ===================== JOINT 3: Elbow Pitch (Y) ===================== -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 ${link_2_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="10.0" velocity="2.0"/>
  </joint>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 ${link_3_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="${link_3_length}"/>
      </geometry>
      <material name="arm_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${link_3_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="${link_3_length}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 ${link_3_length/2}" rpy="0 0 0"/>
      <xacro:arm_cylinder_inertia m="0.05" r="0.02" h="${link_3_length}"/>
    </inertial>
  </link>

  <!-- ===================== JOINT 4: Wrist Pitch (Y) ===================== -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 ${link_3_length}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-pi/2}" upper="${pi/2}" effort="5.0" velocity="2.0"/>
  </joint>

  <link name="link_4">
    <visual>
      <origin xyz="0 0 ${link_4_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="${link_4_length}"/>
      </geometry>
      <material name="arm_material"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${link_4_length/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="${link_4_length}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.04"/>
      <origin xyz="0 0 ${link_4_length/2}" rpy="0 0 0"/>
      <xacro:arm_cylinder_inertia m="0.04" r="0.015" h="${link_4_length}"/>
    </inertial>
  </link>

  <!-- ===================== GRIPPER BASE JOINT: Wrist Rotation (Z) ===================== -->
  <joint name="gripper_base_joint" type="revolute">
    <parent link="link_4"/>
    <child link="gripper_base_link"/>
    <origin xyz="0 0 ${link_4_length}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-pi}" upper="${pi}" effort="5.0" velocity="2.0"/>
  </joint>

  <link name="gripper_base_link">
    <visual>
      <geometry>
        <box size="0.04 0.06 0.02"/>
      </geometry>
      <material name="gripper_material">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.06 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.03"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ===================== GRIPPER: Left Gear (Actuated) ===================== -->
  <joint name="left_gear_joint" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="left_finger_link"/>
    <origin xyz="0.02 0.02 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="1.0" effort="5.0" velocity="1.0"/>
  </joint>

  <link name="left_finger_link">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.01 0.02"/>
      </geometry>
      <material name="gripper_material"/>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.01 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ===================== GRIPPER: Right Gear (Mimic) ===================== -->
  <!--
    LEARNING: Mimic joints follow another joint with a multiplier.
    This is how parallel gripper fingers work.
  -->
  <joint name="right_gear_joint" type="revolute">
    <parent link="gripper_base_link"/>
    <child link="right_finger_link"/>
    <origin xyz="0.02 -0.02 0.01" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.0" upper="0" effort="5.0" velocity="1.0"/>
    <mimic joint="left_gear_joint" multiplier="-1" offset="0"/>
  </joint>

  <link name="right_finger_link">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.01 0.02"/>
      </geometry>
      <material name="gripper_material"/>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.04 0.01 0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <!-- ===================== TOOL FRAME ===================== -->
  <!--
    LEARNING: tool_frame is the grasp point for MoveIt planning.
    All grasp poses are defined relative to this frame.
  -->
  <joint name="tool_joint" type="fixed">
    <parent link="gripper_base_link"/>
    <child link="tool_frame"/>
    <origin xyz="0.06 0 0.01" rpy="0 0 0"/>
  </joint>

  <link name="tool_frame">
    <!-- Virtual frame, no geometry -->
  </link>

</robot>

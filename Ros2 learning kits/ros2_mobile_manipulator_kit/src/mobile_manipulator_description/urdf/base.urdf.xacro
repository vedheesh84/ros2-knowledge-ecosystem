<?xml version="1.0"?>
<!--
  Mobile Base URDF

  LEARNING OBJECTIVES:
  - Understand differential drive kinematics
  - See wheel link structure
  - Learn collision geometry for navigation

  STRUCTURE:
  - body_link (main chassis)
  - 4 wheel links (front_left, front_right, back_left, back_right)
  - arm_mount_link (where arm attaches)
  - camera_mount_link (where camera attaches)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ===================== PROPERTIES ===================== -->
  <xacro:property name="base_length" value="0.5"/>
  <xacro:property name="base_width" value="0.35"/>
  <xacro:property name="base_height" value="0.15"/>
  <xacro:property name="wheel_radius" value="0.075"/>
  <xacro:property name="wheel_width" value="0.04"/>
  <xacro:property name="wheel_separation" value="0.35"/>
  <xacro:property name="wheel_base" value="0.35"/>

  <!-- ===================== INERTIA MACROS ===================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0.0" ixz="0.0"
             iyy="${m*(x*x+z*z)/12.0}" iyz="0.0"
             izz="${m*(x*x+y*y)/12.0}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0.0" ixz="0.0"
             iyy="${m*(3*r*r+h*h)/12.0}" iyz="0.0"
             izz="${m*r*r/2.0}"/>
  </xacro:macro>

  <!-- ===================== WHEEL MACRO ===================== -->
  <xacro:macro name="wheel" params="prefix x_offset y_offset">
    <joint name="${prefix}_joint" type="continuous">
      <parent link="body_link"/>
      <child link="${prefix}_link"/>
      <origin xyz="${x_offset} ${y_offset} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
      <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="${prefix}_link">
      <visual>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_material">
          <color rgba="0.2 0.2 0.2 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.5"/>
        <xacro:cylinder_inertia m="0.5" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- ===================== BODY LINK ===================== -->
  <link name="body_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="base_material">
        <color rgba="0.8 0.4 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <xacro:box_inertia m="10.0" x="${base_length}" y="${base_width}" z="${base_height}"/>
    </inertial>
  </link>

  <!-- ===================== WHEELS ===================== -->
  <xacro:wheel prefix="front_left" x_offset="${wheel_base/2}" y_offset="${wheel_separation/2 + wheel_width/2}"/>
  <xacro:wheel prefix="front_right" x_offset="${wheel_base/2}" y_offset="${-wheel_separation/2 - wheel_width/2}"/>
  <xacro:wheel prefix="back_left" x_offset="${-wheel_base/2}" y_offset="${wheel_separation/2 + wheel_width/2}"/>
  <xacro:wheel prefix="back_right" x_offset="${-wheel_base/2}" y_offset="${-wheel_separation/2 - wheel_width/2}"/>

  <!-- ===================== ARM MOUNT ===================== -->
  <!--
    LEARNING: The arm_mount_link is where the arm attaches.
    This creates a clear separation between base and arm TF chains.
  -->
  <joint name="arm_mount_joint" type="fixed">
    <parent link="body_link"/>
    <child link="arm_mount_link"/>
    <origin xyz="-0.1 0 ${base_height/2}" rpy="0 0 0"/>
  </joint>

  <link name="arm_mount_link">
    <visual>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
      <material name="mount_material">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.05" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <xacro:cylinder_inertia m="0.1" r="0.05" h="0.02"/>
    </inertial>
  </link>

  <!-- ===================== CAMERA MOUNT ===================== -->
  <!--
    LEARNING: Camera is eye-to-base (fixed on body).
    This provides a stable view of the workspace.
  -->
  <joint name="camera_mount_joint" type="fixed">
    <parent link="body_link"/>
    <child link="camera_mount_link"/>
    <origin xyz="${base_length/2 - 0.05} 0 ${base_height/2 + 0.1}" rpy="0 ${pi/6} 0"/>
  </joint>

  <link name="camera_mount_link">
    <visual>
      <geometry>
        <box size="0.02 0.04 0.04"/>
      </geometry>
      <material name="camera_mount_mat">
        <color rgba="0.3 0.3 0.3 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <xacro:box_inertia m="0.05" x="0.02" y="0.04" z="0.04"/>
    </inertial>
  </link>

  <!-- ===================== LIDAR MOUNT ===================== -->
  <joint name="lidar_joint" type="fixed">
    <parent link="body_link"/>
    <child link="laser_frame"/>
    <origin xyz="${base_length/2 - 0.1} 0 ${base_height/2 + 0.05}" rpy="0 0 0"/>
  </joint>

  <link name="laser_frame">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
      <material name="lidar_mat">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.2"/>
      <xacro:cylinder_inertia m="0.2" r="0.04" h="0.05"/>
    </inertial>
  </link>

</robot>

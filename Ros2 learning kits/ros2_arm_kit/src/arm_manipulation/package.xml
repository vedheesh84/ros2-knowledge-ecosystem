<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_manipulation</name>
  <version>1.0.0</version>
  <description>Gripper action server, Cartesian trajectory generation, and autonomous pick-and-place state machine.</description>
  <maintainer email="vedheesh@intelligentsystems.io">Vedheesh B</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>arm_kinematics</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
